class Solution {
    int missingNum(int arr[]) {
//===============================================Method 3===============================
        int n = arr.length+1;
        int x = 0;
        int y = 0;
        for(int i = 1; i<=n; i++){
            x = x^ i;
        }
        
        for(int val : arr){
            y = y ^ val;
        }
        return x ^ y;
// ============================================ Method 2 ===================================
         int hash [] = new int [n+2]; //all filled with 0
         for(int val:arr){
             hash[val] = 1;
         }
         for(int i = 1; i<hash.length; i++){
             if(hash[i] == 0){
                 return i; 
             }
         }
         return 0;
//============================================= Method 1 ====================================
         int sum = n * (n+1)/2;
         for(int val : arr){
             sum = sum - val;
         }
         return sum;
    }
}
