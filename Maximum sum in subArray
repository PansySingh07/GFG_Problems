class Solution {
    int maxSubarraySum(int[] arr) {
        // Code here
        int n = arr.length ; 
        int maximumSum = Integer.MIN_VALUE;
        for (int i = 0; i<n-1; i++){
            int sum = arr[i] + arr[i+1];
            if(sum > maximumSum){
                maximumSum = sum;
            }
        }
        return maximumSum;
    }
}


// ================================= Kadane's Alog =============================
class Solution {
    int maxSubarraySum(int[] arr) {
        int n = arr.length;
        int maxSoFar = arr[0];  
        int currentSum = arr[0];
        
        for (int i = 1; i < n; i++) {
            currentSum = Math.max(arr[i], currentSum + arr[i]);
  
            maxSoFar = Math.max(maxSoFar, currentSum);
        }
        
        return maxSoFar;
    }
}

