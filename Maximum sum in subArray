class Solution {
    int maxSubarraySum(int[] arr) {
        // Code here
        int n = arr.length ; 
        int maximumSum = Integer.MIN_VALUE;
        for (int i = 0; i<n-1; i++){
            int sum = arr[i] + arr[i+1];
            if(sum > maximumSum){
                maximumSum = sum;
            }
        }
        return maximumSum;
    }
}
