class Solution {

    public static String PartyType(int arr[]) {
        // Your code goes here
        HashMap <Long, Boolean> map = new HashMap<>();
        for( long val:arr){
            if(map.get(val) == null){
                map.put(val, true);
            }
            else{
                return "true";
            }
        }
        return "false";
    }
}
